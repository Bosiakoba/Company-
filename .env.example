# Resend (contact form + newsletter) — https://resend.com
# Copy this file to `.env.local` and fill in values (never commit `.env.local`).
RESEND_API_KEY=
# Verified sender in Resend (e.g. onboarding@resend.dev on free tier)
RESEND_FROM_EMAIL=

# Inbox for quote requests and newsletter signups
CONTACT_RECEIVER_EMAIL=

# Optional: Gemini (only if you use features that call the API)
# VITE_GEMINI_API_KEY=
